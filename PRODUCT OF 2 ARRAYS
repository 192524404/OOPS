#include <iostream>
using namespace std;
int main()
{
    int n;
    cout << "Enter size: ";
    cin >> n;
    int a[n], b[n];
    cout << "Enter first array: ";
    for(int i = 0; i < n; i++)
        cin >> a[i];
    cout << "Enter second array: ";
    for(int i = 0; i < n; i++)
        cin >> b[i];
    cout << "Product array: ";
    for(int i = 0; i < n; i++)
        cout << a[i] * b[i] << " ";
    return 0;
}
